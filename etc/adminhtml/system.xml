<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="trusteed" translate="label" sortOrder="300">
            <label>Trusteed</label>
        </tab>
        <section id="trusteed_general" translate="label" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
            <tab>trusteed</tab>
            <label>Agentic Commerce</label>
            <resource>Trusteed_AgenticCommerce::config</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>API Connection</label>
                <field id="api_base_url" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>API Base URL</label>
                    <comment>MCPWebStore API base URL (e.g. https://api.trusteed.xyz)</comment>
                    <validate>required-entry validate-url</validate>
                </field>
                <field id="merchant_id" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Merchant ID</label>
                    <validate>required-entry</validate>
                </field>
                <field id="integration_token" translate="label" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Integration Token</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <validate>required-entry</validate>
                </field>
                <field id="webhook_secret" translate="label" type="obscure" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Webhook Secret</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <validate>required-entry</validate>
                </field>
                <field id="internal_hmac_secret" translate="label comment" type="obscure" sortOrder="42" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Legacy internal key (optional)</label>
                    <comment>Not needed: the module signs its internal calls with a key derived from your connection. Kept only as a fallback for stores that already had one.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="webhook_secret_version" translate="label" type="text" sortOrder="45" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Webhook Secret Version</label>
                    <comment>Increment when rotating the webhook secret. Current: 1</comment>
                </field>
                <field id="connection_id" translate="label comment" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Connection ID</label>
                    <comment>Provided by MCPWebStore after store connection. Used to identify this store in webhook delivery.</comment>
                </field>
            </group>
            <group id="features" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Features</label>
                <field id="webmcp_enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enable WebMCP Bridge</label>
                    <comment>Injects storefront JavaScript bridge. Auto-disabled on Hyvä/PWA Studio themes.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="browser_agent_signature_mode" translate="label comment" type="select" sortOrder="15" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Browser agent signature (Web Bot Auth)</label>
                    <comment>Verifies RFC 9421 signatures of browser agents at checkout. Observe: verify and log only (default). Enforce: a verified signature raises the agent identity; a spoofed one marks an anonymous agent.</comment>
                    <source_model>Trusteed\AgenticCommerce\Model\Config\Source\BrowserAgentSignatureMode</source_model>
                </field>
                <field id="webmcp_checkout_tools" translate="label comment" type="select" sortOrder="17" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>WebMCP checkout tools</label>
                    <comment>Registers get_checkout / update_checkout / complete_checkout in the checkout page for browser agents and enables the trusteed/webmcp/checkout endpoint. Off by default. Never places an order: the buyer confirms.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="phase_b_enabled" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Enable Phase B (Embedded SPA)</label>
                    <comment>Reserved for future Phase B release. Do not enable unless instructed.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
