<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="trusteed_webhook_drain" instance="Trusteed\AgenticCommerce\Cron\DrainOutbox" method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <job name="trusteed_lag_heartbeat" instance="Trusteed\AgenticCommerce\Cron\EmitLagHeartbeat" method="execute">
            <schedule>* * * * *</schedule>
        </job>
    </group>
</config>
