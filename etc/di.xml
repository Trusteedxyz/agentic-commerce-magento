<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
        Plugin: persist trusteed_receipt_uri extension attribute to sales_order DB column.
        Set-once guard: column value is never overwritten once written (immutability).
    -->
    <type name="Magento\Sales\Api\OrderRepositoryInterface">
        <plugin name="trusteed_order_receipt_uri"
                type="Trusteed\AgenticCommerce\Plugin\Repository\OrderRepositoryPlugin"
                sortOrder="10"/>
    </type>

    <!--
        Plugin: manage trusteed_receipt_uri on Order at checkout place-order time.
        Ensures extension attribute container exists before and after order placement.
            -->
    <type name="Magento\Sales\Model\Order\Payment">
        <plugin name="trusteed_order_ext_attr"
                type="Trusteed\AgenticCommerce\Plugin\Sales\OrderExtensionAttribute"
                sortOrder="10"/>
    </type>

    <!--
        SSRF hardening: explicitly wire the
        ApiBaseUrlValidator into the outbound enforcement HTTP clients so the
        admin-configurable api_base_url is allowlist/hash-checked before any
        HMAC-signed payload leaves the store. The constructor argument is
        nullable (legacy unit tests construct positionally), these bindings
        guarantee production always receives the guard.
    -->
    <type name="Trusteed\AgenticCommerce\Service\EnforcementClient">
        <arguments>
            <argument name="urlValidator" xsi:type="object">Trusteed\AgenticCommerce\Model\Security\ApiBaseUrlValidator</argument>
            <!-- Negative cache for the forced JWKS retry. Optional constructor
                 argument: without this binding it would always be null (no cache). -->
            <argument name="cache" xsi:type="object">Magento\Framework\App\CacheInterface</argument>
        </arguments>
    </type>
    <type name="Trusteed\AgenticCommerce\Service\AgentHistoryFetcher">
        <arguments>
            <argument name="urlValidator" xsi:type="object">Trusteed\AgenticCommerce\Model\Security\ApiBaseUrlValidator</argument>
        </arguments>
    </type>

    <!-- Optional constructor arguments are not injected on their own; without
         this `request` would always be null and the X-Trusteed-Agent-* header
         channel would be a read with no producer. -->
    <type name="Trusteed\AgenticCommerce\Observer\CheckoutSubmitBefore">
        <arguments>
            <argument name="request" xsi:type="object">Magento\Framework\App\RequestInterface</argument>
            <!-- `historyFetcher` is an optional constructor argument and Magento does not
                 inject optionals; without this binding it would always be null and no history
                 signal would travel (CheckoutSubmitBeforeHistoryWiringTest reads this file). It
                 is only queried for an agent with a valid token. -->
            <argument name="historyFetcher" xsi:type="object">Trusteed\AgenticCommerce\Service\AgentHistoryFetcher</argument>
        </arguments>
    </type>

    <!--
        SSRF hardening: outbound HMAC/token-bearing callouts
        must allowlist/hash-check the admin-configurable api_base_url before any
        credential leaves the store. The constructor argument is nullable (legacy
        positional unit tests) and fails closed when null, these bindings
        guarantee production always receives the guard.
    -->
    <type name="Trusteed\AgenticCommerce\Model\Webhook\SignaturePublisher">
        <arguments>
            <argument name="urlValidator" xsi:type="object">Trusteed\AgenticCommerce\Model\Security\ApiBaseUrlValidator</argument>
        </arguments>
    </type>
    <type name="Trusteed\AgenticCommerce\Cron\EmitLagHeartbeat">
        <arguments>
            <argument name="urlValidator" xsi:type="object">Trusteed\AgenticCommerce\Model\Security\ApiBaseUrlValidator</argument>
        </arguments>
    </type>
    <type name="Trusteed\AgenticCommerce\Setup\Patch\Data\EmitInstallEvent">
        <arguments>
            <argument name="urlValidator" xsi:type="object">Trusteed\AgenticCommerce\Model\Security\ApiBaseUrlValidator</argument>
        </arguments>
    </type>

    <!--
        Manifest cache: use the default Magento cache frontend so the
        manifest is stored in the shared cache layer (Redis or file).
    -->
    <type name="Trusteed\AgenticCommerce\Model\Manifest\Builder">
        <arguments>
            <argument name="cache" xsi:type="object">Magento\Framework\App\Cache\Type\Config</argument>
        </arguments>
    </type>

    <!--
        Register the module's CLI commands so they are visible to bin/magento:
          - trusteed:check-webserver   (Console\Command\CheckWebserver)
          - trusteed:webhook:status    (Console\Command\WebhookStatus)
    -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="trusteed_check_webserver" xsi:type="object">Trusteed\AgenticCommerce\Console\Command\CheckWebserver</item>
                <item name="trusteed_webhook_status" xsi:type="object">Trusteed\AgenticCommerce\Console\Command\WebhookStatus</item>
            </argument>
        </arguments>
    </type>

    <!--
        Admin notice shown when the store is connected but checkout enforcement
        cannot evaluate anything.

        `EnforcementClient::evaluate()` returns an unconditional ALLOW without an
        `installation_id`, and until now nothing told the merchant: they saw
        "configuration saved successfully" and believed they were protected.

        Hooked in here only, without adding `magento/module-admin-notification` to
        composer.json: if that list does not exist because the merchant disabled
        AdminNotification, the entry stays inert and does not break startup.
    -->
    <type name="Magento\AdminNotification\Model\System\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="trusteed_enforcement_not_provisioned" xsi:type="object">Trusteed\AgenticCommerce\Model\System\Message\EnforcementNotProvisioned</item>
            </argument>
        </arguments>
    </type>

</config>
