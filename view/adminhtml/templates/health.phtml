function formatAge(int $seconds): string {
    if ($seconds < 0)   return (string) __('Never');
    if ($seconds < 60)  return (string) __('Less than 1 minute ago');
    if ($seconds < 3600) return (string) __('%1 min ago', floor($seconds / 60));
    return (string) __('%1 h ago', floor($seconds / 3600));
}

function scoreTone(?int $score): array {
    if ($score === null) return ['#6b7280', '#f3f4f6', '#e5e7eb'];
    if ($score >= 80)    return ['#15803d', '#f0fdf4', '#bbf7d0'];
    if ($score >= 60)    return ['#b45309', '#fef3c7', '#fcd34d'];
    return ['#b91c1c', '#fee2e2', '#fca5a5'];
}

function confidenceLabel(?string $level): string {
    return (string) match ($level) {
        'cold_start'             => __('New store (cap 60)'),
        'human_established'      => __('With human history (cap 85)'),
        'agent_verified_thin'    => __('First agent orders'),
        'agent_verified'         => __('Verified with agents (cap 100)'),
        'insufficient_data'      => __('Not enough data'),
        default                  => __('Unclassified'),
    };
}

$manifestOk = $manifestAge >= 0 && $manifestAge < 3600;
$webhookOk  = $lastWebhookAge < 0 || $lastWebhookAge < 600;
$queueOk    = $outboxLag < 300 && $deadCount === 0;
