        <div id="amcp-root"
             data-section="<?= $block->escapeHtmlAttr($section) ?>"
             data-auto-mount="false"
             style="min-height:400px;font-size:16px;">
            <?php
            // This used to hold, for "mis-reglas", a FIXED list of 24 rules with
            // invented toggles and "Active" states, which stayed on screen if the
            // SPA failed to mount. A merchant with a configured store saw rules
            // that were not theirs. Now every section starts the same way:
            // loading, and if the connection fails, an error saying it failed.
            ?>
            <noscript><p style="padding:20px"><?= $block->escapeHtml(__('Enable JavaScript to see the Trusteed panel.')) ?></p></noscript>
            <div style="padding:20px;color:#666;font-family:sans-serif;font-size:16px;">
                <?= $block->escapeHtml(__('Loading Trusteed…')) ?>
            </div>
        </div>

        <script src="<?= $block->escapeUrl($bundleUrl) ?>" defer></script>
        <script>
            (function () {
                'use strict';

                /**
                 * Requests a token from the S2S relay. It only REQUESTS: caching is
                 * handled by `TrusteedEmbed.createTokenSource`. The token used to be
                 * captured ONCE and returned forever; it expires in 900 s or less,
                 * so after 15 minutes the panel fell into a 401.
                 */
                async function magentoFetchToken() {
                    var cfg = window.__AMCP_MAGENTO_CONFIG__;
                    var body = new URLSearchParams();
                    body.set('form_key', cfg.formKey);

                    var resp = await fetch(cfg.relayUrl, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { Accept: 'application/json' },
                        body: body
                    });
                    if (!resp.ok) {
                        throw new Error('[Trusteed] token relay HTTP ' + resp.status);
                    }
                    var data = await resp.json();
                    if (data.error) {
                        throw new Error('[Trusteed] token error: ' + data.error);
                    }
                    if (!data.token) {
                        throw new Error('[Trusteed] no token in Magento response');
                    }
                    return { token: data.token, expires_at: data.expires_at };
                }

                /**
                 * A connection failure is rendered as a connection failure.
                 *
                 * Replaces `showDemoFallback`, which on the same failure showed
                 * a "panel not available in local demo, connect store" message to
                 * an already configured store and, under "agents", a FIXED table of
                 * Claude, ChatGPT and Gemini sales with EUR amounts. Fake data in
                 * the merchant's admin.
                 */
                function showConnectionError(rootEl) {
                    var m = window.__AMCP_MAGENTO_CONFIG__.messages;
                    rootEl.textContent = '';
                    var box = document.createElement('div');
                    box.setAttribute('role', 'alert');
                    box.style.cssText = 'padding:24px;max-width:700px;font-family:system-ui,sans-serif';
                    var h = document.createElement('h2');
                    h.style.cssText = 'font-size:20px;font-weight:700;color:#111827;margin:0 0 12px';
                    h.textContent = m.errorTitle;
                    var p = document.createElement('p');
                    p.style.cssText = 'color:#374151;font-size:15px;margin:0 0 16px';
                    p.textContent = m.errorBody;
                    var retry = document.createElement('button');
                    retry.type = 'button';
                    retry.className = 'action-secondary';
                    retry.textContent = m.retry;
                    retry.addEventListener('click', function () { window.location.reload(); });
                    var status = document.createElement('a');
                    status.href = 'https://trusteed.xyz/status';
                    status.target = '_blank';
                    status.rel = 'noreferrer';
                    status.style.cssText = 'margin-left:16px;color:#2563eb';
                    status.textContent = m.status;
                    box.appendChild(h);
                    box.appendChild(p);
                    box.appendChild(retry);
                    box.appendChild(status);
                    rootEl.appendChild(box);
                }

                var attempts = 0;
                function mountWhenReady() {
                    var rootEl = document.getElementById('amcp-root');
                    if (!rootEl) return;
                    if (typeof window.TrusteedEmbed === 'undefined') {
                        attempts++;
                        if (attempts < 80) { setTimeout(mountWhenReady, 50); return; }
                        showConnectionError(rootEl);
                        return;
                    }
                    if (rootEl.dataset.amcpMounted === '1') return;
                    rootEl.dataset.amcpMounted = '1';
                    var section = rootEl.dataset.section || 'mis-reglas';
                    var tokens = window.TrusteedEmbed.createTokenSource(magentoFetchToken);
                    // The relay is checked before mounting: if it does not answer, the
                    // error is reported here instead of as an empty SPA.
                    tokens.getToken().then(function (tok) {
                        if (!tok) { showConnectionError(rootEl); return; }
                        window.TrusteedEmbed.mount(rootEl, {
                            section: section,
                            source: 'magento-embed',
                            apiBase: window.__AMCP_MAGENTO_CONFIG__.apiBase,
                            locale: window.__AMCP_MAGENTO_CONFIG__.locale,
                            getToken: tokens.getToken,
                            refreshToken: tokens.refresh
                        });
                    }).catch(function () { showConnectionError(rootEl); });
                }

                document.addEventListener('DOMContentLoaded', mountWhenReady);
                if (document.readyState !== 'loading') mountWhenReady();
            })();
        </script>
    <?php endif; ?>

</div>
