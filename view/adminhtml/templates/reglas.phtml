        <script>
            (function () {
                'use strict';

                var tokenCache = null;
                var tokenExpiresAt = 0;
                var EXPIRY_BUFFER_MS = 30000;

                async function magentoGetToken() {
                    var now = Date.now();
                    if (tokenCache !== null && now < tokenExpiresAt - EXPIRY_BUFFER_MS) {
                        return tokenCache;
                    }
                    var cfg = window.__AMCP_MAGENTO_CONFIG__;
                    var body = new URLSearchParams();
                    body.set('form_key', cfg.formKey);

                    var resp = await fetch(cfg.relayUrl, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { Accept: 'application/json' },
                        body: body
                    });

                    if (!resp.ok) {
                        throw new Error('__DEMO_OFFLINE__:HTTP ' + resp.status);
                    }
                    var data = await resp.json();
                    if (data.error) {
                        throw new Error('[Trusteed] token error: ' + data.error);
                    }
                    if (!data.token) {
                        throw new Error('[Trusteed] no token in Magento response');
                    }

                    tokenCache = data.token;
                    tokenExpiresAt = data.expires_at
                        ? new Date(data.expires_at).getTime()
                        : Date.now() + 300 * 1000;
                    return tokenCache;
                }


