<?php
/**
 * Rules template: admin SPA mount.
 *
 * Mounts the Trusteed SPA (same bundle as the WordPress, PrestaShop and Odoo
 * modules) in the "mis-reglas" section with source="magento-embed" (a
 * first-class source: the server-side relay issues the opaque token as
 * magento-embed and the embed routes accept it). The token is obtained
 * through a server-side S2S relay; the HMAC never reaches the DOM.
 *
 * @var \Trusteed\AgenticCommerce\Block\Adminhtml\SpaShell $block
 */

$bundleUrl    = $block->getBundleUrl();
$isConfigured = $block->isConfigured();
$relayUrl     = $block->getTokenRelayUrl();
$formKey      = $block->getFormKey();
$apiBase      = $block->getApiBase();
$merchantId   = $block->getMerchantId();
$section      = $block->getInitialSection();
// Detect section from URL: controllers don't pass section data explicitly
$requestUri = $_SERVER['REQUEST_URI'] ?? '';
if (strpos($requestUri, '/trusteed/pagos/') !== false) {
    $section = 'payment-methods';
} elseif (strpos($requestUri, '/trusteed/agentes/') !== false) {
    $section = 'agentes';
} elseif (strpos($requestUri, '/trusteed/ajustes/') !== false) {
    $section = 'settings';
} elseif (strpos($requestUri, '/trusteed/reglas/') !== false) {
    $section = 'mis-reglas';
} elseif (strpos($requestUri, '/trusteed/ventas/') !== false) {
    // The Sales route mounts the mis-ventas section (list of Trust Receipts
    // plus receipt download).
    $section = 'mis-ventas';
}
?>
<div id="trusteed-admin-wrapper" style="margin:0;padding:0;">

    <?php if ($bundleUrl === null): ?>
        <div class="message message-warning" style="margin:20px;">
            <strong>Trusteed:</strong>
            El bundle de la SPA no está compilado. Ejecuta
            <code>pnpm --filter @agenticmcpstores/wp-admin-spa build:magento</code>
            desde la raíz del monorepo y recarga esta página.
        </div>
    <?php elseif (!$isConfigured): ?>
        <div class="message message-notice" style="margin:20px;">
            <strong>Trusteed:</strong>
            Aún no has conectado tu tienda.
            <a href="<?= $block->escapeUrl($block->getUrl('trusteed/setup/wizard')) ?>">
                Conectar ahora →
            </a>
        </div>
    <?php else: ?>
        <script>
            window.__AMCP_MAGENTO_CONFIG__ = {
                relayUrl:   <?= json_encode($relayUrl, JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
                formKey:    <?= json_encode($formKey, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
                apiBase:    <?= json_encode($apiBase, JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
                merchantId: <?= json_encode($merchantId, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
                // The PHP admin screens are fully localized via i18n CSVs
                // (es_ES/en_US), so the embedded SPA follows the Magento backend
                // interface locale too, keeping PHP screens and the SPA coherent
                // in whichever language the admin user has selected.
                locale:     <?= json_encode($block->getAdminLocale(), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
                // The connection-failure text, already translated. No sample
                // data: a failure is rendered as a failure.
                messages: {
                    errorTitle: <?= json_encode((string) __("We can't connect to Trusteed right now."), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
                    errorBody:  <?= json_encode((string) __('Your store is still connected and nothing has changed in it. Try again in a few minutes; if it keeps happening, check the Trusteed status page.'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
                    retry:      <?= json_encode((string) __('Try again'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
                    status:     <?= json_encode((string) __('See Trusteed status'), JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>
                }
            };
        </script>

