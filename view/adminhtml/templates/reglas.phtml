                function mountWhenReady() {
                    if (typeof window.TrusteedEmbed === 'undefined') {
                        if (!window._amcpMountAttempts) window._amcpMountAttempts = 0;
                        window._amcpMountAttempts++;
                        if (window._amcpMountAttempts < 80) { setTimeout(mountWhenReady, 50); return; }
                        var rootEl = document.getElementById("amcp-root");
                        if (rootEl) showDemoFallback(rootEl, rootEl.dataset.section || "mis-reglas");
                        return;
                    }
                    var rootEl = document.getElementById('amcp-root');
                    if (!rootEl) return;
                    var section = rootEl.dataset.section || 'mis-reglas';
                    // Pre-check token before mounting SPA — show demo immediately if relay offline
                    magentoGetToken().then(function(tok) {
                        if (!tok) { showDemoFallback(rootEl, section); return; }
                        window.TrusteedEmbed.mount(rootEl, {
                            section: section,
                            source: 'magento-embed',
                            apiBase: window.__AMCP_MAGENTO_CONFIG__.apiBase,
                            getToken: async function() { return tok; }
                        });
                    }).catch(function() { if (section !== 'mis-reglas') showDemoFallback(rootEl, section); });
                }

                document.addEventListener('DOMContentLoaded', mountWhenReady);
                // Fallback: if SPA takes >3s and root still shows spinner, inject demo directly
                setTimeout(function() {
                    var rootEl = document.getElementById('amcp-root');
                    if (!rootEl) return;
                    var spinner = rootEl.querySelector('div[style*="padding:20px"]');
                    if (spinner) {
                        var section = rootEl.dataset.section || 'mis-reglas';
                        var demos = {};
                        demos['mis-reglas'] = rootEl.getAttribute('data-demo-html') || '';
                        if (!demos['mis-reglas']) {
                            // get via inline script tag
                            var demoEl = document.getElementById('amcp-demo-html-' + section);
                            if (demoEl) rootEl.innerHTML = demoEl.textContent;
                        }
                    }
                }, 3000);
                // Also try immediately via mountWhenReady (handles already-loaded case)
                if (document.readyState !== 'loading') mountWhenReady();
            })();
        </script>
