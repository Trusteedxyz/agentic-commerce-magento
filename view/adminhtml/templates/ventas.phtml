<script>
(function () {
    var ACTIVE_COLOR  = '#2c6ecb';
    var ACTIVE_BORDER = '2px solid #2c6ecb';
    var INACTIVE_COLOR  = '#6b7280';
    var INACTIVE_BORDER = '2px solid transparent';

    window.amcpSwitchTab = function (id) {
        document.querySelectorAll('.amcp-tab-panel').forEach(function (el) {
            el.style.display = 'none';
        });
        document.querySelectorAll('#amcp-ventas-tabs button').forEach(function (btn) {
            btn.style.color       = INACTIVE_COLOR;
            btn.style.borderBottom = INACTIVE_BORDER;
            btn.style.fontWeight  = '400';
        });
        var panel = document.getElementById('amcp-tab-' + id);
        if (panel) panel.style.display = 'block';
        var btn = document.getElementById('amcp-tab-btn-' + id);
        if (btn) {
            btn.style.color       = ACTIVE_COLOR;
            btn.style.borderBottom = ACTIVE_BORDER;
            btn.style.fontWeight  = '600';
        }
    };

    // Activar primera pestaña al cargar
    amcpSwitchTab('orders');
})();
</script>
