<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">trusteed_setup_form.trusteed_setup_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Trusteed Setup Wizard</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>

    <settings>
        <buttons>
            <button name="save">
                <class>primary</class>
                <label translate="true">Guardar</label>
            </button>
        </buttons>
        <namespace>trusteed_setup_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>trusteed_setup_form.trusteed_setup_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="trusteed_setup_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="trusteed/setup/save"/>
        </settings>
        <dataProvider class="Trusteed\AgenticCommerce\Model\Setup\DataProvider"
                      name="trusteed_setup_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <!-- api_base_url: oculto, pre-rellenado con producción -->
    <fieldset name="step_api_connection">
        <settings>
            <collapsible>false</collapsible>
            <opened>false</opened>
            <label translate="true"/>
        </settings>
        <field name="api_base_url" formElement="hidden">
            <settings>
                <dataType>text</dataType>
                <dataScope>api_base_url</dataScope>
            </settings>
        </field>
    </fieldset>

    <!-- merchant_id: oculto, se rellena al conectar -->
    <fieldset name="step_merchant_id">
        <settings>
            <collapsible>false</collapsible>
            <opened>false</opened>
            <label translate="true"/>
        </settings>
        <field name="merchant_id" formElement="hidden">
            <settings>
                <dataType>text</dataType>
                <dataScope>merchant_id</dataScope>
            </settings>
        </field>
    </fieldset>

    <!-- integration_token: oculto, se rellena automáticamente via postMessage -->
    <fieldset name="step_token_hidden">
        <settings>
            <collapsible>false</collapsible>
            <opened>false</opened>
            <label translate="true"/>
        </settings>
        <field name="integration_token" formElement="hidden">
            <settings>
                <dataType>text</dataType>
                <dataScope>integration_token</dataScope>
            </settings>
        </field>
    </fieldset>

    <!-- Hidden identifiers populated post-OAuth by wizard-mixin.js -->
    <fieldset name="step_connection_ids">
        <settings>
            <collapsible>false</collapsible>
            <opened>false</opened>
            <label translate="true"/>
        </settings>
        <field name="connection_id" formElement="hidden">
            <settings>
                <dataType>text</dataType>
                <dataScope>connection_id</dataScope>
            </settings>
        </field>
        <field name="integration_token_secret_id" formElement="hidden">
            <settings>
                <dataType>text</dataType>
                <dataScope>integration_token_secret_id</dataScope>
            </settings>
        </field>
        <field name="webhook_secret_secret_id" formElement="hidden">
            <settings>
                <dataType>text</dataType>
                <dataScope>webhook_secret_secret_id</dataScope>
            </settings>
        </field>
    </fieldset>

    <!-- Internal HMAC secret (Gap #8 heartbeat) -->
    <fieldset name="step_internal_hmac">
        <settings>
            <collapsible>true</collapsible>
            <opened>false</opened>
            <label translate="true">Internal HMAC Secret</label>
        </settings>
        <field name="internal_hmac_secret" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Internal HMAC Secret</label>
                <dataScope>internal_hmac_secret</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <notice translate="true">Used to sign internal heartbeat requests. Keep secret.</notice>
            </settings>
        </field>
    </fieldset>

    <!-- Enforcement (CEL) credentials — activate the checkout enforcement layer.
         Provisioned by Trusteed ops. Until both are set, enforcement is a no-op. -->
    <fieldset name="step_enforcement">
        <settings>
            <collapsible>true</collapsible>
            <opened>false</opened>
            <label translate="true">Checkout Enforcement (CEL)</label>
        </settings>
        <field name="enforcement_installation_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Enforcement Installation ID</label>
                <dataScope>enforcement_installation_id</dataScope>
                <notice translate="true">Provided by Trusteed. Required to activate the agentic checkout enforcement layer.</notice>
            </settings>
        </field>
        <field name="enforcement_hmac_secret" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Enforcement HMAC Secret</label>
                <dataScope>enforcement_hmac_secret</dataScope>
                <notice translate="true">Provided by Trusteed. Leave blank to keep the existing secret. Keep this value confidential.</notice>
            </settings>
        </field>
    </fieldset>

    <!-- Botón OAuth: abre trusteed.xyz para que el merchant autorice -->
    <fieldset name="step_integration_token">
        <settings>
            <collapsible>true</collapsible>
            <opened>true</opened>
            <label translate="true">Conecta tu tienda con Trusteed</label>
        </settings>

        <container name="connect_button_container">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Magento_Ui/js/form/components/button</item>
                    <item name="title" xsi:type="string" translate="true">Conectar con Trusteed →</item>
                    <item name="actions" xsi:type="array">
                        <item name="0" xsi:type="array">
                            <item name="targetName" xsi:type="string">trusteed_setup_form.trusteed_setup_form</item>
                            <item name="actionName" xsi:type="string">connectWithTrusteed</item>
                        </item>
                    </item>
                </item>
            </argument>
        </container>
    </fieldset>

    <!-- Qué tiendas activar -->
    <fieldset name="step_store_views">
        <settings>
            <collapsible>true</collapsible>
            <opened>false</opened>
            <label translate="true">¿Qué tiendas quieres activar?</label>
        </settings>

        <field name="store_view_selection" formElement="multiselect">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">trusteed</item>
                </item>
            </argument>
            <settings>
                <label translate="true">Mis tiendas</label>
                <dataType>text</dataType>
                <dataScope>store_view_selection</dataScope>
                <notice translate="true">Elige qué tiendas verán los compradores cuando usen asistentes de IA.</notice>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Trusteed\AgenticCommerce\Model\Config\Source\StoreViews"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
    </fieldset>

</form>
